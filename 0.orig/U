FoamFile
{
    version     2.0;
    format      binary;
    class       volVectorField;
    location    "0";
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    sphere_set1_1
    {
        type            codedFixedValue;
        value           uniform (0 0 0);
        name            myBC_set1_1;

        code
        #{
            static const scalar shiftX = 0.5;
            static const scalar shiftY = 0.75;
            static const scalar shiftZ = 0.5;
            static const vector CENTER(shiftX, shiftY, shiftZ);
            static const scalar rotate_speed_max = 1e0/60*6.28;
            const fvPatch& boundaryPatch = patch();
            const vectorField& Cf = boundaryPatch.Cf();
            vectorField rot = rotate_speed_max * vector(0,1,0) ^ (Cf - CENTER);
            operator==(rot);
        #};
    }
    sphere_set1_2
    {
        type            codedFixedValue;
        value           uniform (0 0 0);
        name            myBC_set1_2;

        code
        #{
            static const scalar shiftX = 1.0;
            static const scalar shiftY = 0.75;
            static const scalar shiftZ = 0.5;
            static const vector CENTER(shiftX, shiftY, shiftZ);
            static const scalar rotate_speed_max = - 1e0/60*6.28;
            const fvPatch& boundaryPatch = patch();
            const vectorField& Cf = boundaryPatch.Cf();
            vectorField rot = rotate_speed_max * vector(0,1,0) ^ (Cf - CENTER);
            operator==(rot);
        #};
    }
    sphere_set1_3
    {
        type            codedFixedValue;
        value           uniform (0 0 0);
        name            myBC_set1_3;

        code
        #{
            static const scalar shiftX = 0.75;
            static const scalar shiftY = 0.5;
            static const scalar shiftZ = 0.5;
            static const vector CENTER(shiftX, shiftY, shiftZ);
            static const scalar rotate_speed_max = - 1e0/60*6.28;
            const fvPatch& boundaryPatch = patch();
            const vectorField& Cf = boundaryPatch.Cf();
            vectorField rot = rotate_speed_max * vector(1,0,0) ^ (Cf - CENTER);
            operator==(rot);
        #};
    }
    sphere_set1_4
    {
        type            codedFixedValue;
        value           uniform (0 0 0);
        name            myBC_set1_4;

        code
        #{
            static const scalar shiftX = 0.75;
            static const scalar shiftY = 1.0;
            static const scalar shiftZ = 0.5;
            static const vector CENTER(shiftX, shiftY, shiftZ);
            static const scalar rotate_speed_max = 1e0/60*6.28;
            const fvPatch& boundaryPatch = patch();
            const vectorField& Cf = boundaryPatch.Cf();
            vectorField rot = rotate_speed_max * vector(1,0,0) ^ (Cf - CENTER);
            operator==(rot);
        #};
    }
    allWalls
    {
        type            slip;
//        type            fixedValue;
//        value           uniform (0 0 0);
//       type            zeroGradient;
    }
}


