FoamFile
{
    version     2.0;
    format      binary;
    class       volVectorField;
    location    "0";
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    inlet
    {
        type            slip;
//        type            fixedValue;
//        value           uniform (0 0.02 0);
    }
    outlet
    {
        type            slip;
//        type            inletOutlet;
//        inletValue      uniform (0 0 0);
//        value           uniform (0 0 0);
    }
/*
    monkey 
    {
        type            noSlip;
    }
    monkeyBack
    {
        type            noSlip;
    }
*/
    sphere
    {
        type            codedFixedValue;
        value           uniform (0 0 0);
        name            myBC_set1_1;

        code
        #{
            static const scalar shiftX = 0.5;
            static const scalar shiftY = 0.5;
            static const scalar shiftZ = 0.5;
            static const vector CENTER(shiftX, shiftY, shiftZ);
            static const scalar rotate_speed_max = 1e2/60*6.28;
            const fvPatch& boundaryPatch = patch();
            const vectorField& Cf = boundaryPatch.Cf();
            vectorField rot = rotate_speed_max * vector(0,0,1) ^ (Cf - CENTER);
            operator==(rot);
        #};
    }
    top
    {
        type            slip;
    }
    bottom
    {
        type            slip;
    }
    back
    {
        type            slip;
    }
    front
    {
        type            slip;
    }
}


