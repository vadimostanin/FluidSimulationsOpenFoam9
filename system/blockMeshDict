FoamFile
{
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

convertToMeters 1;

length 1.5;
width 1.5;
height 1;
resolutionX 45;
resolutionY 45;
resolutionZ 30;

vertices
(
    (0 0 0)//0
    ($length 0 0)//1
    ($length $width 0)//2
    (0 $width 0)//3
    (0 0 $height)//4
    ($length 0 $height)//5
    ($length $width $height)//6
    (0 $width $height)//7
);

blocks
(
    hex (0 1 2 3 4 5 6 7) ($resolutionX $resolutionY $resolutionZ)
    simpleGrading (
                    ((0.2 1 10)(0.6 1 1)(0.2 1 0.1))
                    ((0.2 1 10)(0.6 1 1)(0.2 1 0.1))
                    ((0.2 1 10)(0.6 1 1)(0.2 1 0.1))
                )
);

edges
(
);

boundary
(
    allWalls
    {
        type wall;
        faces
        (
            (0 1 5 4)  // Грань front
            (3 7 6 2)  // Грань back
            (0 4 7 3)  // Грань left
            (1 2 6 5)  // Грань right
            (0 3 2 1)  // Грань bottom
            (4 5 6 7)  // Грань top
        );
    }
);

mergePatchPairs
(
);

